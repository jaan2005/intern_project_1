# ---- Core ----
PORT=5000
MONGO_URI=mongodb://localhost:27017/lms
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Public URL of this API (used to build video URLs when STORAGE_DRIVER=local)
PUBLIC_API_URL=http://localhost:5000
ADMIN_EMAIL=admin@lms.test
ADMIN_PASSWORD=Admin@12345

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Video storage: "local" (dev, no AWS needed) or "s3" (S3 + CloudFront) ----
STORAGE_DRIVER=local
MAX_VIDEO_MB=500
# FFMPEG_PATH=/usr/bin/ffmpeg   (optional; otherwise the ffmpeg-static package is used)

# ---- AWS (only when STORAGE_DRIVER=s3) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# CloudFront distribution domain, e.g. https://d1234abcd.cloudfront.net
CLOUDFRONT_URL=

# ---- Payments ----
# Leave STRIPE_SECRET_KEY empty to use the built-in simulated checkout (no account needed).
# Set it to a Stripe TEST key (sk_test_...) to use real Stripe. Force one with PAYMENT_PROVIDER=mock or stripe.
# PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Share of each sale kept by the platform
PLATFORM_FEE_PERCENT=20

# ---- LiveKit Cloud ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
