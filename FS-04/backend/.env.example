# Copy to .env  (for running the backend outside Docker). Docker Compose reads FS-04/.env instead.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
POSTGRES_DB=pm
POSTGRES_USER=pm
POSTGRES_PASSWORD=pm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Billing: leave STRIPE_SECRET_KEY empty to use the built-in simulated checkout (test card 4242 4242 4242 4242)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhooks may point at localhost/private addresses only in development
WEBHOOK_ALLOW_PRIVATE=1
