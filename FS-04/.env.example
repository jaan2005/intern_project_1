# Copy to .env before `docker compose up`
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=pm
# Leave empty to use the built-in simulated billing (test card 4242 4242 4242 4242). Set a Stripe TEST key to use real Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 = webhooks may target localhost/private addresses (fine for a local demo). Use 0 on a public server.
WEBHOOK_ALLOW_PRIVATE=1
